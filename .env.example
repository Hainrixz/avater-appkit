# ─────────────────────────────────────────────────────────────
# Avatar App Kit — every value here is EMPTY on purpose.
# No key ships with this repo. You bring your own.
# ─────────────────────────────────────────────────────────────

# OPTIONAL. You do not need this: the app asks for your key in the UI and keeps it
# in an httpOnly cookie for your browser. Fill this in only if you would rather not
# paste it each time on a fresh browser profile.
#
# Format is KEY_ID:KEY_SECRET, both from https://cloud.higgsfield.ai
# NEVER prefix it with NEXT_PUBLIC_ — that would inline it into the browser bundle.
HIGGSFIELD_API_KEY=

# OPTIONAL. Only needed if you want to pull more UI components from 21st.dev:
#   npx shadcn@latest add "https://21st.dev/r/<author>/<slug>?api_key=$API_KEY_21ST"
API_KEY_21ST=
